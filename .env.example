# ── melodya.web-vite ─────────────────────────────────────────────
# Copiá este archivo a .env.local y ajustá los valores. Vite solo expone al navegador las variables con prefijo VITE_
# (NO pongas secretos acá: todo lo que empieza con VITE_ queda visible en el bundle).

# URL del backend de Melodya (melodya.backend) INCLUIDO el prefijo /api. OBLIGATORIA.
# Usá un backend local o de pruebas; nunca producción para pruebas de escritura.
VITE_API_BASE_URL=http://localhost:4000/api

# Origen público canónico para construir enlaces compartibles (/songs/:id, /user/:id).
# Vacío = se usa window.location.origin (desarrollo). En producción: https://app.melodya.com.ar
VITE_PUBLIC_ORIGIN=

# ── Solo servidor Open Graph (server/server.mjs, `npm start`) — NO llega al navegador ──
# Backend al que el servidor consulta los datos públicos de canciones y perfiles. Si falta, usa VITE_API_BASE_URL.
OG_API_BASE_URL=
# Origen público para las URLs absolutas de og:url / og:image (si falta, se deduce de la solicitud).
OG_PUBLIC_ORIGIN=
# Puerto del servidor con Open Graph.
PORT=3100
